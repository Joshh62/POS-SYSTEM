WHATSAPP_SCHEDULED_REPORTS_ENABLED=false

# Set exactly one controlled tenant ID for canary delivery.
WHATSAPP_DAILY_REPORT_CANARY_BUSINESS_ID=
# Authorize only after the canary has passed and the production sender/template are ready.
WHATSAPP_DAILY_REPORT_GLOBAL_AUTHORIZED=false

# Runtime database-pool resilience. Defaults are applied when omitted.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_KEEPALIVES_IDLE_SECONDS=30
DATABASE_KEEPALIVES_INTERVAL_SECONDS=10
DATABASE_KEEPALIVES_COUNT=5
